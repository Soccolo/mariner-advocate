# The Streamlit app does not load .env files automatically. Set these values as
# environment variables, or use an uncommitted .streamlit/secrets.toml file.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ZAI_API_KEY=

# Current defaults verified against provider documentation on 2026-08-14.
OPENAI_MODEL=gpt-5.6-sol
ANTHROPIC_MODEL=claude-opus-5
ZAI_MODEL=glm-5.3

# claude-opus-5 thinks before answering and max_tokens covers thinking plus the
# visible answer, so this budget must be generous or the JSON is cut short.
ANTHROPIC_MAX_TOKENS=32000
ANTHROPIC_EFFORT=high

# GLM reasoning is billed from the same output allowance as the final JSON.
ZAI_MAX_TOKENS=32000

DEMO_MODE=false
PUBLIC_DEMO_ONLY=false
APP_PASSWORD=
REQUEST_TIMEOUT_SECONDS=420
