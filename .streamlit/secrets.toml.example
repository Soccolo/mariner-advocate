# Never commit a real .streamlit/secrets.toml file.
# For a private, controlled deployment:
OPENAI_API_KEY = ""
ANTHROPIC_API_KEY = ""
ZAI_API_KEY = ""

OPENAI_MODEL = "gpt-5.6-sol"
ANTHROPIC_MODEL = "claude-opus-5"
ZAI_MODEL = "glm-5.3"

# Reasoning and the final JSON share one output allowance on both models, so
# these budgets must cover thinking as well as the answer.
ANTHROPIC_MAX_TOKENS = 32000
ANTHROPIC_EFFORT = "high"
ZAI_MAX_TOKENS = 32000

# A basic shared gate only. Use proper identity-aware access control in production.
APP_PASSWORD = "replace-with-a-long-random-password"
DEMO_MODE = false
PUBLIC_DEMO_ONLY = false
REQUEST_TIMEOUT_SECONDS = 420

# For Streamlit Community Cloud, do not add real provider keys. Use only:
# DEMO_MODE = true
# PUBLIC_DEMO_ONLY = true
